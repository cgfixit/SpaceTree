# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*
.localized
__MACOSX/
Icon?

# Linux
# https://github.com/github/gitignore/blob/main/Global/Linux.gitignore
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
nohup.out

# Editors
.idea/
.vscode/
*.swp
*.swo

# Coverage and core dumps
*.profraw
*.profdata
tarpaulin-report.html
lcov.info
core
core.[0-9]*
